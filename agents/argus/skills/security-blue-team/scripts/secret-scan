#!/usr/bin/env bash
# SPDX-FileCopyrightText: Copyright (C) Nicolas Lamirault <nicolas.lamirault@gmail.com>
# SPDX-License-Identifier: Apache-2.0
#
# secret-scan — grep a tree for high-signal leaked-secret patterns.
# Exit 0 = clean, 1 = likely secret(s) found, 2 = usage error.
# A heuristic pre-commit / CI aid, NOT a guarantee. Extend PATTERNS for your stack.
#
#   secret-scan [PATH]   (default: .)

set -euo pipefail

target="${1:-.}"
[[ -e "$target" ]] || { echo "secret-scan: no such path: $target" >&2; exit 2; }

# label|extended-regex — kept deliberately high-signal to limit false positives.
PATTERNS=(
  'AWS access key|AKIA[0-9A-Z]{16}'
  'Private key block|-----BEGIN (RSA|EC|OPENSSH|PGP|DSA)? ?PRIVATE KEY-----'
  'GitHub token|gh[pousr]_[A-Za-z0-9]{36,}'
  'Slack token|xox[baprs]-[A-Za-z0-9-]{10,}'
  'Google API key|AIza[0-9A-Za-z_-]{35}'
  'Generic assigned secret|(secret|passwd|password|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/+_-]{16,}'
)

# Prefer ripgrep; fall back to grep -r. Skip VCS/vendor noise either way.
scan() {
  local re="$1"
  if command -v rg >/dev/null 2>&1; then
    rg -n --no-heading -i \
       --glob '!.git' --glob '!node_modules' --glob '!vendor' \
       -e "$re" "$target" 2>/dev/null || true
  else
    grep -rEnI -i \
      --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=vendor \
      -e "$re" "$target" 2>/dev/null || true
  fi
}

found=0
for entry in "${PATTERNS[@]}"; do
  label="${entry%%|*}"
  re="${entry#*|}"
  hits="$(scan "$re")"
  if [[ -n "$hits" ]]; then
    found=1
    printf '🔴 %s:\n%s\n\n' "$label" "$hits"
  fi
done

if [[ "$found" -eq 0 ]]; then
  echo "🟢 secret-scan: no high-signal secrets found in ${target}"
  exit 0
fi
echo "🔴 secret-scan: likely secret(s) found — do not commit"
exit 1
